{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PD2 Trader 中文版",
  "version": "0.11.7-beta.2",
  "identifier": "com.pd2-trader.chinese",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "mainBinaryName": "pd2-trader-installer",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerIcon": "icons/favicon.ico",
        "sidebarImage": "icons/banner.bmp"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/favicon.ico",
      "icons/favicon-32x32.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0Nzc4Q0QxODkxMTlDRTMKUldUam5CR0owWXgzeEo5bTBET3l1SE9LMlpWWHI1YzdCaDdQWGtuSW5jRXhIMUNack0yRHFoazYK",
      "endpoints": [
        "https://github.com/SolairsVIP/pd2-trader-chinese/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
